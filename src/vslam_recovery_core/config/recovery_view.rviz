Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Normal Cell Count: 50
      Cell Size: 1.0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: true

    - Class: rviz_default_plugins/Camera
      Name: Camera
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/image_raw
      Camera Info Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/camera_info
      Image Rendering: background and overlay
      Transport Hint: raw
      Queue Size: 2
      Zoom: 1.0
      Overlay Alpha: 0.5
      Value: true

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 500
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Shape:
        Value: Arrow
        Axes Length: 0.3
        Axes Radius: 0.05
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.05
      Position Tolerance: 0.1
      Angle Tolerance: 0.1

    - Class: rviz_default_plugins/Path
      Name: Forward Path
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /trajectory/forward_path
      Color: 0; 200; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Pose Color: 0; 200; 0
      Value: true

    - Class: rviz_default_plugins/Path
      Name: Recovery Path
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /trajectory/recovery_path
      Color: 255; 0; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Pose Color: 255; 0; 0
      Value: true

    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /trajectory/planned_path
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Pose Color: 255; 255; 0
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 6.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.7
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1280
  X: 80
  Y: 80
